# Server-only OpenAI configuration for conversational tool selection.
OPENAI_API_KEY=
# Optional; defaults to gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini

# Server-only Upstash REST credentials for rate limiting and aggregate analytics.
# Either the conventional pair or the Vercel Marketplace pair may be used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_KV_REST_API_URL=
UPSTASH_REDIS_REST_KV_REST_API_TOKEN=
